{
	"name": "hipreme_engine",
	"description": "Open-Source D Game Engine",
	"authors": [
		"Hipreme"
	],
	"copyright": "Copyright © 2018 - 2022, Hipreme",
	"license": "CC BY-4.0",
	"buildOptions": [
		"debugMode",
		"debugInfo",
		"debugInfoC",
		"warnings"
	],
	"stringImportPaths": [
		"assets"
	],
	"dflags-ldc": ["--disable-verify"],
	"dflags-osx": ["-checkaction=C"],
	"versions": [
		"HIPREME_DEBUG",
		"HipCheckUnknownKeycode",
		"HipScriptingAPI",
		"GL_45",
		"GL_ARB",
		"AL_EFX"
	],
	"subPackages": [
		"tools/hbuild/"
	],
	"sourcePaths": [
		"source"
	],
	"dependencies": {
		"assetmanager": {"path": "./modules/assetmanager"},
		"audio": {"path": "./modules/audio", "version": "*"},
		"bind": {"path": "./modules/bind", "version": "*"},
		"config": {"path": "./modules/config", "version": "*"},
		"console": {"path": "./modules/console", "version": "*"},
		"error": {"path": "./modules/error", "version": "*"},
		"filesystem": {"path": "./modules/filesystem", "version": "*"},
		"hipengine_api:interfaces": {"path": "./api", "version": "*"},
		"math": {"path": "./modules/math", "version": "*"},
		"renderer": {"path": "./modules/renderer", "version": "*"},
		"util": {"path": "./modules/util", "version": "*"},
		"net": {"path": "./modules/net", "version": "*"},
		"game_renderer": {"path": "./modules/game_renderer"}
	},
	"configurations": [
		{
			"name": "desktop",
			"targetPath": "bin/desktop",
			"targetType": "executable",
			"versions": [
				"Desktop",
				"Standalone",
				"Test"
			]
		},
		{
			"name": "desktop-release",
			"targetType": "staticLibrary",
			"dflags-ldc": [
				"--fvisibility=hidden"
			],
			"versions": [
				"Desktop",
				"Standalone"
			],
			"subConfigurations-windows": {
				"renderer": "dxonly",
				"audio": "dxonly",
				"assets": "gamut"
			}
		},
		{
			"name": "nodx",
			"targetPath": "bin/desktop",
			"targetType": "executable",
			"versions": [
				"Desktop",
				"Standalone",
				"Test"
			],
			"subConfigurations": {
				"audio": "nodx",
				"renderer": "nodx"
			}
		},
		{
			"name": "script",
			"targetPath": "bin/desktop",
			"targetType": "executable",
			"excludedSourceFiles": ["source/hip/api/package.d"],
			"dependencies": {
				"compilewatcher": {"path": "dependencies/compilewatcher"}
			},
			"subConfigurations-linux": {
				"renderer": "nodx"
			},
			"versions": [
				"Desktop",
				"Load_DScript"
			],
			"dflags-ldc": ["-link-defaultlib-shared=true"],
			"lflags-linux-ldc": ["--export-dynamic"]
		},
		{
			"name": "wasm",
			"dependencies": {
				"runtime": {"path": "dependencies/runtime", "version": "*"},
				"d_std": {"path": "modules/d_std", "version": "*"}
			},
			"targetType": "staticLibrary",
			"stringImportPaths": [
				"build/wasm/generated"
			],
			"subConfigurations": {
				"d_std": "wasm",
				"console": "wasm",
				"runtime": "wasm",
				"assets": "wasm",
				"audio": "wasm",
				"filesystem": "wasm",
				"renderer": "wasm"
			},
			"versions": [
				"Standalone",
				"HipDStdFile",
				"CarelessAlocation",
				"InitExternal"
			]
		},
		{
			"name": "android",
			"libs": ["log", "android", "OpenSLES", "EGL", "GLESv3"],
			"dependencies": {
				"jni": {"path": "./modules/jni", "version": "*"}
			},
			"subConfigurations": {
				"audio": "android",
				"console": "android",
				"renderer": "android"
			},
			"targetPath": "bin/android/",
			"targetType": "library",
			"versions": ["InitExternal", "Standalone", "OpenSLES1_1"]
		},
		{
			"name": "appleos",
			"subConfigurations": { "renderer": "appleos", "audio": "nodx"},
			"versions": ["OpenAL", "Standalone", "AppleOS"],
			"targetType": "staticLibrary"
		},
		{
			"name": "ios",
			"subConfigurations": {"renderer": "appleos", "audio": "ios"},
			"targetType": "staticLibrary",
			"versions": ["Standalone", "AppleOS"]
		},
		{
			"name": "psvita",
			"targetType": "staticLibrary",
			"versions": ["Standalone", "InitExternal"],
			"dependencies": {
				"d_std": {"path": "modules/d_std"},
				"runtime": {"path": "dependencies/runtime"}
			},
			"subConfigurations": {
				"runtime": "psvita",
				"d_std": "psvita",
				"assets": "psvita",
				"audio": "openal",
				"renderer": "psvita"
			}
		},
		{
			"name": "nintendo-switch",
			"targetType": "staticLibrary",
			"versions": ["Standalone"],
			"dependencies": {
				"d_std": {"path": "modules/d_std"}
			},
			"subConfigurations": {
				"d_std": "psvita",
				"assets": "psvita",
				"audio": "openal",
				"renderer": "nintendo-switch"
			}
		},
		{
			"name": "uwp",
			"targetType": "staticLibrary",
			"subConfigurations": {
				"audio": "dxonly",
				"renderer": "uwp"
			},
			"dflags-ldc": ["-link-defaultlib-shared=true"],
			"versions-windows": [
				"Standalone",
				"InitExternal",
				"UWP"
			]
		},
		{
			"name": "customrt",
			"dependencies": {
				"d_std": {"path": "modules/d_std", "version": "*"},
				"runtime": {"path": "dependencies/runtime", "version": "*"}
			},
			"lflags-windows": [
				"/SUBSYSTEM:CONSOLE"
			],
			"subConfigurations": {
				"runtime": "psvita",
				"d_std": "psvita",
				"assets": "gamut",
				"audio": "null"
			},
			"versions": [
				"Standalone",
				"GameBuildTest",
				"Desktop",
				"CarelessAlocation"
			],
			"targetType": "executable"
		}
	],
	"toolchainRequirements": {
		"frontend": ">=2.099",
		"dub": ">=1.31.0"
	}
}
